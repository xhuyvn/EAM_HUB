{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ppm-findings",
  "description": "Internal M0 schema for domain findings emitted by the PPM reducer",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "enum": [
          "architecture_drift",
          "relationship_proposed",
          "identity_conflict",
          "conflicting_claims"
        ]
      },
      "severity": {
        "enum": [
          "info",
          "warning",
          "review_required",
          "blocker"
        ]
      },
      "target_ref": {
        "type": "string",
        "minLength": 1
      },
      "criterion_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "details": {
        "type": "object"
      }
    },
    "required": [
      "kind",
      "severity",
      "target_ref",
      "criterion_ids",
      "details"
    ],
    "additionalProperties": false
  }
}
