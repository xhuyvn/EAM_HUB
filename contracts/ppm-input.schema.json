{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "project_id",
    "snapshot_refs",
    "baseline_revision"
  ],
  "additionalProperties": false
}
